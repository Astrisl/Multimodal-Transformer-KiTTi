Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR scan
      Enabled: true
      Topic:
        Value: /lidar/points
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color Transformer: Intensity
    - Class: rviz_default_plugins/PointCloud2
      Name: SLAM map (FAST-LIO2)
      Enabled: true
      Topic:
        Value: /Laser_map
      Size (m): 0.03
      Style: Points
      Color Transformer: AxisColor
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected objects
      Enabled: true
      Topic:
        Value: /detected_objects/markers
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: lidar
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Pitch: 0.6
      Yaw: 3.14
      Focal Point:
        X: 10
        Y: 0
        Z: 0
