Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 10
      Plane Cell Count: 40
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 3
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR scan
      Enabled: true
      Topic:
        Value: /lidar/points
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Points
      Color Transformer: Intensity
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Ego path
      Enabled: true
      Topic:
        Value: /ego/path
      Color: 255; 200; 0
      Line Style: Billboards
      Line Width: 0.3
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected objects
      Enabled: true
      Topic:
        Value: /detected_objects/markers
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Target Frame: lidar
      Distance: 35
      Pitch: 0.55
      Yaw: 3.14
      Focal Point:
        X: 12
        Y: 0
        Z: 0
Window Geometry:
  Width: 1280
  Height: 800
  X: 0
  Y: 0
